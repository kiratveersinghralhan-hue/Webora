# Public form ID from Formspree's Integration tab, not the entire endpoint URL.
# No management/API keys are needed. Place your real ID in ignored .env.local.
VITE_FORMSPREE_FORM_ID=
# Full public HTTPS site URL including its repository path; supplied by Pages.
VITE_SITE_URL=
# Leading and trailing /, e.g. /repository/; supplied by Pages. Local default: /.
VITE_BASE_PATH=
